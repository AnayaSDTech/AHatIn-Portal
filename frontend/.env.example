# Base URL of the FastAPI backend. Leave empty to use the same origin (/api), which the
# dev server and `npm run preview` proxy to http://localhost:8000 (see vite.config.ts).
VITE_API_BASE_URL=

# Show the demo accounts and the demo authenticator on the login pages. Set to false in production.
VITE_SHOW_DEMO_HINTS=true
