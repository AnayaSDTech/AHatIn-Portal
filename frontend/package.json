{
  "name": "ahat-in-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demo website and student portal for AHat International Educational Consultancy",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hostinger": "npm run build && powershell -NoProfile -Command \"Remove-Item ahat-frontend.zip -ErrorAction SilentlyContinue; Compress-Archive -Path dist/* -DestinationPath ahat-frontend.zip\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "lucide-react": "0.441.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "react-router-dom": "6.26.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vite-plugin-pwa": "0.20.5",
    "workbox-window": "7.1.0"
  }
}
