# Apache/LiteSpeed (Hostinger shared hosting): HTTPS, single-page app routing and caching.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always HTTPS, and one address: www.ahat.in → ahat.in.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Serve real files and folders as they are; send every other path to the app.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers for every page and file.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Demo content: keep the site out of search results until the real content is in. Remove this line to go live.
  Header always set X-Robots-Tag "noindex, nofollow"

  # Built assets have hashed names, so they can be cached for a year.
  <FilesMatch "\.(js|css|woff2?|png|svg|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # These must always be fresh, or users keep an old version of the app.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
