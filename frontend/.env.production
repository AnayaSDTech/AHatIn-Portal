# Production build for Hostinger (https://ahat.in). Public values only: they end up in the website's code.
# The backend runs on Render at api.ahat.in (custom domain).
VITE_API_BASE_URL=https://api.ahat.in

# The demo accounts stay usable on the live site; set to false to hide their hints on the login pages.
VITE_SHOW_DEMO_HINTS=true
