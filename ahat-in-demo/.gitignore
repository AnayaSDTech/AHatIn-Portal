# Dependencies (Vercel installs them from package-lock.json)
node_modules/
.pnpm-store/

# Build output (Vercel builds it)
dist/
dev-dist/
build/
*.tsbuildinfo
.vite/

# Vercel project link created by the CLI
.vercel/

# Environment files: keep secrets out of Git (.env.example is kept as a template)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests and coverage
coverage/
.nyc_output/
test-results/
playwright-report/
screenshots/

# Editors and IDEs (keep shared VS Code recommendations if added later)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Temporary files
*.tmp
*.temp
.cache/
.eslintcache
