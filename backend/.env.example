# Copy to .env and adjust. Every value can also be set as an environment variable.

# development | staging | production
APP_ENV=development
# Where the portal is opened (used in email links)
APP_BASE_URL=http://localhost:5173

# Google Meet room used for every online session (hosted by info@ahat.in).
MEETING_LINK=https://meet.google.com/juz-bodt-wbd
# Only if the frontend is served from another origin (comma-separated). Not needed with the Vite proxy.
API_ALLOWED_ORIGINS=

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ahat

# Production: long random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-session-secret-change-me
OTP_PEPPER=dev-otp-pepper-change-me
# Production: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# true in production (HTTPS only)
COOKIE_SECURE=false

# File storage: local (development) or s3 (production, private bucket)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/uploads
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Virus scanning (required in production): clamd host and port
CLAMAV_HOST=
CLAMAV_PORT=3310

# Email. Resend is used when RESEND_API_KEY is set; otherwise SMTP when SMTP_HOST is set;
# otherwise emails are written to the log. MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=AHat <no-reply@ahat.example>
# Who gets overdue and deadline alerts (default: all active administrators)
ADMIN_ALERT_EMAILS=

BUSINESS_TIMEZONE=Asia/Kolkata
# true: background jobs run inside the API (single server). false: run `python -m app.worker` separately.
RUN_BACKGROUND_JOBS=true
LOG_LEVEL=INFO
